apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  labels:
    machineconfiguration.openshift.io/role: master
  name: 50-keepalived-v6
spec:
  config:
    ignition:
      version: 3.2.0
    storage:
      files:
      - contents:
          source: data:text/plain;charset=utf-8;base64,@POD
        mode: 0644
        overwrite: true
        path: /etc/kubernetes/manifests/keepalived-v6.yaml
      - contents:
          source: data:text/plain;charset=utf-8;base64,@CONFIG
        mode: 0644
        overwrite: true
        path: /etc/keepalived/keepalived-v6.conf
